APP_ENV=development
PORT=8080

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/
MONGODB_DATABASE=heno_motita

JWT_ACCESS_SECRET=GENERAR_SECRETO_SEGURO
JWT_ISSUER=heno-motita-api
JWT_ACCESS_DURATION=15m

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

FRONTEND_URL=http://localhost:5173

# Correo SMTP para enviar los códigos de activación.
# Si SMTP_HOST queda vacío, los correos se imprimen en consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=tucorreo@gmail.com
SMTP_FROM_NAME=Heno Motita