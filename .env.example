APP_ENV=development
PORT=8080

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/
MONGODB_DATABASE=heno_motita

JWT_ACCESS_SECRET=GENERAR_SECRETO_SEGURO
JWT_ISSUER=heno-motita-api
JWT_ACCESS_DURATION=15m

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

FRONTEND_URL=http://localhost:5173

# Correo con la API de SendGrid para enviar los códigos de activación.
# Si SENDGRID_API_KEY queda vacío, los correos se imprimen en consola.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=correo_verificado@tudominio.com
SENDGRID_FROM_NAME=Heno Motita